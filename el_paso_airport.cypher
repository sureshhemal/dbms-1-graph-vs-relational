// el_paso_airport as a property graph, generated from MySQL by scripts/mysql_to_cypher.py
// Load with: cypher-shell -u neo4j -p password --file el_paso_airport.cypher

MATCH (n) DETACH DELETE n;

// --- constraints (also create the indexes used for lookups below) ---
CREATE CONSTRAINT passenger_id IF NOT EXISTS FOR (node:Passenger) REQUIRE node.passID IS UNIQUE;
CREATE CONSTRAINT aircraft_id IF NOT EXISTS FOR (node:Aircraft) REQUIRE node.aircraftID IS UNIQUE;
CREATE CONSTRAINT trip_id IF NOT EXISTS FOR (node:Trip) REQUIRE node.tripID IS UNIQUE;
CREATE CONSTRAINT department_id IF NOT EXISTS FOR (node:Department) REQUIRE node.deptID IS UNIQUE;
CREATE CONSTRAINT staff_id IF NOT EXISTS FOR (node:Staff) REQUIRE node.staffID IS UNIQUE;
CREATE CONSTRAINT pilot_id IF NOT EXISTS FOR (node:Pilot) REQUIRE node.pilotID IS UNIQUE;
CREATE CONSTRAINT service_id IF NOT EXISTS FOR (node:Service) REQUIRE node.serviceID IS UNIQUE;

